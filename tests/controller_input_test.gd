extends SceneTree
var game
func button(code:int,pressed:bool=true):
 var e=InputEventJoypadButton.new();e.device=7;e.button_index=code;e.pressed=pressed;game._input(e)
func axis(code:int,value:float):
 var e=InputEventJoypadMotion.new();e.device=7;e.axis=code;e.axis_value=value;game._input(e)
func _initialize():call_deferred("run")
func run():
 game=load("res://scripts/main.gd").new();root.add_child(game)
 game.set_process(false);game.set_physics_process(false);game.sound_on=false
 button(JOY_BUTTON_A);assert(game.mode=="entrance")
 button(JOY_BUTTON_START);assert(game.mode=="paused")
 button(JOY_BUTTON_START);assert(game.mode=="entrance")
 game.mode="intro";game._start_or_resume()
 axis(JOY_AXIS_LEFT_X,0.15);assert(game.controller.device==-1,"Stick drift must not claim controller")
 axis(JOY_AXIS_LEFT_Y,-1);button(JOY_BUTTON_X)
 assert(game.fight.queued_buttons&136==136,"Up + west must feed left head punch bits")
 button(JOY_BUTTON_X,false);axis(JOY_AXIS_LEFT_Y,0)
 assert(not game.controller_state.high and not game.controller_state.left)
 button(JOY_BUTTON_B);assert(game.fight.guard)
 button(JOY_BUTTON_B,false);assert(not game.fight.guard)
 button(JOY_BUTTON_DPAD_DOWN);assert(game.fight.guard)
 button(JOY_BUTTON_DPAD_DOWN,false);assert(not game.fight.guard)
 button(JOY_BUTTON_START);assert(game.mode=="paused" and game.controller_state.is_empty())
 button(JOY_BUTTON_A);assert(game.mode=="fight")
 button(JOY_BUTTON_RIGHT_SHOULDER);assert(game.controller_state.right)
 button(JOY_BUTTON_A);button(JOY_BUTTON_RIGHT_SHOULDER,false)
 assert(game.controller_state.right,"Alias release must not release another held punch binding")
 button(JOY_BUTTON_A,false);assert(not game.controller_state.right)
 game.mode="intro";game._start_or_resume();axis(JOY_AXIS_LEFT_X,-1)
 assert(game.controller_state.dodge_left and game.fight.queued_buttons&2)
 axis(JOY_AXIS_LEFT_X,0);assert(not game.controller_state.dodge_left)
 game.mode="intro";game._start_or_resume();game.fight.stars=1;button(JOY_BUTTON_Y)
 assert(game.fight.queued_buttons&16,"North button must use recovered special input")
 game._controller_connection_changed(7,false)
 assert(game.mode=="paused" and game.controller.device==-1 and game.controller_state.is_empty())
 button(JOY_BUTTON_START);assert(game.mode=="fight" and not game.fight.guard)
 print("CONTROLLER: menu, pause, drift, head/body input, aliases, guard, dodge, special and disconnect passed")
 print("Detected pads: ",Input.get_connected_joypads())
 game.queue_free();await process_frame;quit()
